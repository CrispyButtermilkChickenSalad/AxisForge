<?xml version="1.0" encoding="UTF-8" ?>
<!-- Probe/calibration subprocesses use UDP to avoid intermittent Docker SHM
     delivery stalls. Other ROS participants retain their configured transport. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>axisforge_probe_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="axisforge_probe_udp" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>axisforge_probe_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
