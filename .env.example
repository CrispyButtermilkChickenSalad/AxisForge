# Copy to .env. Use id -u / id -g to match ownership to your checkout.
LOCAL_UID=1000
LOCAL_GID=1000
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
# Enable only for a commissioned UR cell; the worker never publishes Portenta extrusion.
AXISFORGE_SYNC_ENABLE=0
AXISFORGE_SYNC_PORT=8081
HEATER_CHECK_TIMEOUT_S=300
ROBOT_IP=192.168.0.100

# Placeholder until the Klipper host address is known.
# With Linux host networking, 127.0.0.1 means the Docker HOST itself.
MOONRAKER_URL=http://127.0.0.1:7125
# Set only if your Moonraker installation requires an API key; never commit .env.
MOONRAKER_API_KEY=
BRIDGE_PORT=8080
ROSBRIDGE_PORT=9090

# Optional browser links. Empty values use the dashboard's defaults.
FLUIDD_URL=
MAINSAIL_URL=
PRINTER_UI_URL=
ALPS_LOGGER_URL=

# Only for the existing Portenta / micro-ROS workflow.
MICROROS_DEVICE=/dev/ttyACM0
MICROROS_BAUD=115200
